{
  "manifest_version": 3,
  "name": "ReadEase",
  "version": "1.0.0",
  "description": "Accessibility layer that restyles web pages with one click.",
  "permissions": ["storage", "activeTab"],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "commands": {
    "toggle-profile": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle ReadEase profile on/off"
    }
  }
}
